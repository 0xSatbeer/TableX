{
  "name": "QueryX",
  "author": "QueryX",
  "themes": [
    {
      "name": "QueryX Light",
      "mode": "light",
      "font.family": "Inter",
      "font.size": 13.714285,
      "mono_font.family": "JetBrains Mono",
      "mono_font.size": 12.5,
      "radius": 4,
      "radius.lg": 10,
      "shadow": false,
      "colors": {
        "background": "#FCFCFD",
        "foreground": "#1C1D22",
        "border": "#E1E3E8",
        "ring": "#4C5BD9",
        "caret": "#3B49C4",
