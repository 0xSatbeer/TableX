        "primary.active.background": "#3542B5",
        "primary.foreground": "#FFFFFF",
        "secondary.background": "#EEF0F3",
        "secondary.hover.background": "#E6E8EC",
        "secondary.active.background": "#DDE0E6",
        "secondary.foreground": "#1C1D22",

        "success.background": "#1E8E5A",
        "success.foreground": "#1A794D",
        "warning.background": "#B26B00",
        "warning.foreground": "#9A5C00",
        "danger.background": "#C93434",
        "danger.foreground": "#C53333",
        "info.background": "#1C7FA6",
        "info.foreground": "#197295",

