      "highlight": {
        "editor.background": "#FCFCFD",
        "editor.foreground": "#2A2C33",
        "editor.active_line.background": "#F2F3F6",
        "editor.line_number": "#9A9FAB",
        "editor.active_line_number": "#4A4E59",
        "editor.invisible": "#D5D8DE",
        "syntax": {
          "keyword": { "color": "#4C5BD9" },
          "string": { "color": "#2F7D3A" },
          "string.escape": { "color": "#127A93" },
          "string.special": { "color": "#2F7D3A" },
          "number": { "color": "#A65E00" },
          "boolean": { "color": "#A65E00" },
          "constant": { "color": "#A65E00" },
          "comment": { "color": "#767B88", "font_style": "italic" },
          "comment.doc": { "color": "#767B88", "font_style": "italic" },
          "function": { "color": "#127A93" },
          "type": { "color": "#8B44C7" },
          "constructor": { "color": "#8B44C7" },
          "operator": { "color": "#5F6472" },
          "punctuation": { "color": "#6B7080" },
          "property": { "color": "#3A3D45" },
          "attribute": { "color": "#4C5BD9" },
          "variable": { "color": "#2A2C33" },
          "variable.special": { "color": "#4C5BD9" },
          "title": { "color": "#A65E00", "font_weight": 600 },
          "emphasis": { "font_style": "italic" },
          "emphasis.strong": { "font_weight": 700 }
        }
