        "description_list.label.foreground": "#3A3D45",

        "chart.1": "#6874E0",
        "chart.2": "#4C5BD9",
        "chart.3": "#1C7FA6",
        "chart.4": "#1E8E5A",
        "chart.5": "#B26B00",
        "chart.grid": "#E1E3E899",
        "chart.bullish": "#1E8E5A",
        "chart.bearish": "#C93434",

        "base.red": "#C93A3A",
        "base.red.light": "#C24E4E",
