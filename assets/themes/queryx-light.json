        "link": "#3B49C4",
        "link.hover": "#2E3AA8",
        "link.active": "#4C5BD9",
        "drag.border": "#4C5BD9",
        "drop_target.background": "#4C5BD91A",
        "skeleton.background": "#EEF0F3",
        "progress.bar.background": "#4C5BD9",
        "switch.background": "#CDD0D7",
        "slider.background": "#4C5BD9",
        "slider.thumb.background": "#FFFFFF",

        "scrollbar.background": "#00000000",
        "scrollbar.thumb.background": "#9A9FAB80",
