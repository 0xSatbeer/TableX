        "base.blue": "#4C5BD9",
        "base.blue.light": "#5E6AD6",
        "base.yellow": "#9A6A00",
        "base.yellow.light": "#97700A",
        "base.magenta": "#9046C8",
        "base.magenta.light": "#9655CC",
