        "editor.line_number": "#4A4E59",
        "editor.active_line_number": "#A9ADB7",
        "editor.invisible": "#33363D",
        "syntax": {
          "keyword": { "color": "#9AA6FF" },
          "string": { "color": "#9FD4A3" },
          "string.escape": { "color": "#7FCFE0" },
          "string.special": { "color": "#9FD4A3" },
          "number": { "color": "#E7B77A" },
          "boolean": { "color": "#E7B77A" },
          "constant": { "color": "#E7B77A" },
          "comment": { "color": "#5E6370", "font_style": "italic" },
          "comment.doc": { "color": "#5E6370", "font_style": "italic" },
          "function": { "color": "#7FCFE0" },
          "type": { "color": "#D3A6F5" },
          "constructor": { "color": "#D3A6F5" },
          "operator": { "color": "#A9ADB7" },
          "punctuation": { "color": "#7A7F8C" },
          "property": { "color": "#C6CAD4" },
          "attribute": { "color": "#9AA6FF" },
          "variable": { "color": "#D5D7DD" },
          "variable.special": { "color": "#9AA6FF" },
          "title": { "color": "#E7B77A", "font_weight": 600 },
          "emphasis": { "font_style": "italic" },
          "emphasis.strong": { "font_weight": 700 }
