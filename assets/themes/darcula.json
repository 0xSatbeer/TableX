      "highlight": {
        "editor.background": "#2B2B2B",
        "editor.foreground": "#A9B7C6",
        "editor.active_line.background": "#323232",
        "editor.line_number": "#606366",
        "editor.active_line_number": "#A4A3A3",
        "editor.invisible": "#4A4A4A",
        "syntax": {
          "keyword": { "color": "#CC7832" },
          "string": { "color": "#6A8759" },
          "string.escape": { "color": "#CC7832" },
          "string.special": { "color": "#6A8759" },
          "number": { "color": "#6897BB" },
          "boolean": { "color": "#CC7832" },
          "constant": { "color": "#9876AA" },
          "comment": { "color": "#808080", "font_style": "italic" },
          "comment.doc": { "color": "#629755", "font_style": "italic" },
          "function": { "color": "#FFC66D" },
          "type": { "color": "#A9B7C6" },
          "constructor": { "color": "#FFC66D" },
          "operator": { "color": "#A9B7C6" },
          "punctuation": { "color": "#CC7832" },
          "property": { "color": "#9876AA" },
          "attribute": { "color": "#BBB529" },
          "variable": { "color": "#A9B7C6" },
          "variable.special": { "color": "#94558D" },
          "title": { "color": "#FFC66D", "font_weight": 600 },
          "emphasis": { "font_style": "italic" },
          "emphasis.strong": { "font_weight": 700 }
        }
      }
    }
  ]
}
