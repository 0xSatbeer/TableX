{
  "name": "Darcula",
  "author": "TableX",
  "themes": [
    {
      "name": "Darcula",
      "mode": "dark",
      "font.family": "Inter",
      "font.size": 13.714285,
      "mono_font.family": "JetBrains Mono",
      "mono_font.size": 12.5,
      "radius": 4,
      "radius.lg": 10,
      "shadow": false,
      "colors": {
        "background": "#3C3F41",
        "foreground": "#BBBBBB",
        "border": "#323232",
        "ring": "#4A88C7",
        "caret": "#BBBBBB",
        "selection.background": "#214283",
        "overlay": "#00000080",
        "window.border": "#323232",

        "muted.background": "#313335",
        "muted.foreground": "#ADADAD",
        "accent.background": "#4B6EAF",
        "accent.foreground": "#FFFFFF",

        "primary.background": "#4A88C7",
        "primary.hover.background": "#5394D6",
        "primary.active.background": "#3F7AB5",
        "primary.foreground": "#0F1012",
        "secondary.background": "#4C5052",
        "secondary.hover.background": "#565A5C",
        "secondary.active.background": "#5E6366",
        "secondary.foreground": "#DFE1E5",

        "success.background": "#62B543",
        "success.foreground": "#6CC24A",
        "warning.background": "#E2A53A",
        "warning.foreground": "#E2A53A",
        "danger.background": "#FF8A87",
        "danger.foreground": "#2B2B2B",
        "info.background": "#6AABF5",
        "info.foreground": "#7AB6F7",

        "input.border": "#646464",
        "popover.background": "#3C3F41",
        "popover.foreground": "#CCCCCC",
        "link": "#589DF6",
        "link.hover": "#78B0F8",
        "link.active": "#4A88C7",
        "drag.border": "#4A88C7",
        "drop_target.background": "#4A88C726",
        "skeleton.background": "#3C3F41",
        "progress.bar.background": "#4A88C7",
        "switch.background": "#4C5052",
        "slider.background": "#4A88C7",
        "slider.thumb.background": "#CCCCCC",

        "scrollbar.background": "#00000000",
        "scrollbar.thumb.background": "#5A5D5FB3",
        "scrollbar.thumb.hover.background": "#6E7173",

        "title_bar.background": "#3C3F41",
