        "list.even.background": "#3C3F41",
        "list.head.background": "#3C3F41",

        "tab_bar.background": "#3C3F41",
        "tab_bar.segmented.background": "#313335",
        "tab.background": "#00000000",
        "tab.foreground": "#ADADAD",
        "tab.active.background": "#4E5254",
        "tab.active.foreground": "#E6E6E6",

        "table.background": "#2B2B2B",
        "table.even.background": "#2B2B2B",
        "table.head.background": "#3B3B3B",
        "table.head.foreground": "#BBBBBB",
        "table.hover.background": "#323232",
        "table.active.background": "#214283",
        "table.active.border": "#4A88C7",
        "table.row.border": "#373737",

        "group_box.background": "#313335",
        "group_box.foreground": "#CCCCCC",
        "accordion.background": "#313335",
        "description_list.label.background": "#313335",
        "description_list.label.foreground": "#BBBBBB",

        "chart.1": "#6897BB",
        "chart.2": "#CC7832",
        "chart.3": "#9876AA",
        "chart.4": "#6A8759",
        "chart.5": "#FFC66D",
        "chart.grid": "#51515199",
        "chart.bullish": "#62B543",
        "chart.bearish": "#FF8A87",

        "base.red": "#FF6B68",
        "base.red.light": "#FF9C9A",
        "base.green": "#62B543",
        "base.green.light": "#8FCF76",
        "base.blue": "#589DF6",
        "base.blue.light": "#8DBCF9",
        "base.yellow": "#E2A53A",
        "base.yellow.light": "#EDC27A",
        "base.magenta": "#9876AA",
        "base.magenta.light": "#B9A3C6",
        "base.cyan": "#299999",
        "base.cyan.light": "#6CC1C1"
